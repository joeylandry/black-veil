# Postgres connection string (Supabase, Neon, or any Postgres host). For Supabase use the
# pooled "Transaction" string so it works from serverless route handlers.
#
# No database yet? Use an embedded one for local work; migrations apply automatically:
#   DATABASE_URL="pglite:./.pglite"
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Signs session cookies (readers and staff). Any long random string: openssl rand -hex 32
SESSION_SECRET=""

# The staff passphrase for /admin. Any long random string.
ADMIN_SECRET=""

# Optional. Without it, sign-in links are printed to the server console instead of emailed.
RESEND_API_KEY=""
EMAIL_FROM="File 245 <onboarding@resend.dev>"
