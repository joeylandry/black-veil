# Postgres connection string (Supabase, Neon, or any Postgres host).
# For Supabase, use the pooled "Transaction" connection string so it works
# from serverless/Next.js route handlers.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Signs session cookies for magic-link sign-in. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Shared passphrase staff enter at /admin to approve or reject point claims
# during the event. Any long random string.
ADMIN_SECRET=""

# Required in production. Without it, local dev logs magic-link sign-in emails
# to the server console; a production build refuses to pretend it sent them.
# EMAIL_FROM must be on a domain verified in Resend — the default
# onboarding@resend.dev sender only delivers to the Resend account's own email.
RESEND_API_KEY=""
EMAIL_FROM="The Black Veil <onboarding@resend.dev>"
